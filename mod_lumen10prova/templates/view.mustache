<div class="l10-card">
{{{intro}}}<p>{{#str}}confirmation,mod_lumen10prova{{/str}}</p>
{{#exitlock}}<p class="alert alert-warning">{{#str}}securitynotice,mod_lumen10prova{{/str}}</p>{{/exitlock}}
<span class="l10-stat">{{#str}}timelabel,mod_lumen10prova{{/str}}: {{time}}</span>
<span class="l10-stat">{{#str}}attemptslabel,mod_lumen10prova{{/str}}: {{attempts}}</span>
<span class="l10-stat">{{#str}}grade,mod_lumen10prova{{/str}}: {{grade}}</span>
<span class="l10-stat">{{#str}}gradepass,mod_lumen10prova{{/str}}: {{gradepass}}</span>
<div class="l10-actions">{{#actions}}{{>mod_lumen10prova/link}}{{/actions}}
{{#available}}{{#modal}}<button id="l10-open-exam" type="button" disabled class="btn btn-primary" aria-haspopup="dialog">{{#str}}openexam,mod_lumen10prova{{/str}}</button>{{/modal}}
<a href="{{quizurl}}" class="btn btn-outline-secondary">{{startlabel}}</a>{{/available}}</div>
{{^available}}<p role="status">{{unavailable}}</p>{{/available}}
<p>{{#str}}savingnotice,mod_lumen10prova{{/str}}</p></div>
