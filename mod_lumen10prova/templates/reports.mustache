<div class="l10-card"><h3>{{#str}}phototitle,mod_lumen10prova{{/str}}</h3><p>{{#str}}photonotice,mod_lumen10prova{{/str}}</p>
<form method="post"><input type="hidden" name="id" value="{{id}}"><input type="hidden" name="sesskey" value="{{sesskey}}">
<label for="l10-photoref">{{#str}}photoref,mod_lumen10prova{{/str}}</label> <input id="l10-photoref" name="photoref" maxlength="350" required>
<button class="btn btn-secondary">{{#str}}checkreference,mod_lumen10prova{{/str}}</button></form>
{{#message}}<p role="{{#invalid}}alert{{/invalid}}{{^invalid}}status{{/invalid}}">{{message}}</p>{{/message}}</div>
<div class="l10-card"><h3>{{#str}}examreports,mod_lumen10prova{{/str}}</h3><div class="l10-actions">{{#links}}{{>mod_lumen10prova/link}}{{/links}}</div>
{{#stats}}<p>{{stats}}</p>{{/stats}}<h4>{{#str}}auditlatest,mod_lumen10prova{{/str}}</h4><div class="l10-scroll"><table class="generaltable"><thead><tr>
<th>{{#str}}date,mod_lumen10prova{{/str}}</th><th>{{#str}}student,mod_lumen10prova{{/str}}</th><th>{{#str}}attempt,mod_lumen10prova{{/str}}</th><th>{{#str}}event,mod_lumen10prova{{/str}}</th><th>{{#str}}detail,mod_lumen10prova{{/str}}</th>
</tr></thead><tbody>{{#logs}}<tr><td>{{date}}</td><td>{{user}}</td><td>{{attempt}}</td><td>{{kind}}</td><td>{{detail}}</td></tr>{{/logs}}</tbody></table></div></div>
