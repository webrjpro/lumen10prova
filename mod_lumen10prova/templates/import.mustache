<div class="l10-card"><h3>{{#str}}importtitle,mod_lumen10prova{{/str}}</h3>
<p>{{#str}}importinstructions,mod_lumen10prova{{/str}}</p><p>{{#str}}importtypes,mod_lumen10prova{{/str}}</p>
<p><a class="btn btn-outline-secondary" href="{{templateurl}}">{{#str}}downloadtemplate,mod_lumen10prova{{/str}}</a>
<a class="btn btn-outline-secondary" href="{{nativeurl}}">{{#str}}nativequestions,mod_lumen10prova{{/str}}</a></p>
<form method="post" enctype="multipart/form-data"><input type="hidden" name="id" value="{{id}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="preview">
<label for="l10-import">{{#str}}importfile,mod_lumen10prova{{/str}}</label><input id="l10-import" class="form-control" type="file" name="questions" accept=".csv,.xlsx" required>
<p><button class="btn btn-primary">{{#str}}previewimport,mod_lumen10prova{{/str}}</button></p></form>
{{#haspreview}}<h4>{{previewtitle}}</h4><div class="l10-scroll"><table class="generaltable"><thead><tr><th>{{#str}}importtypename,mod_lumen10prova{{/str}}</th><th>{{#str}}importquestion,mod_lumen10prova{{/str}}</th><th>{{#str}}importanswer,mod_lumen10prova{{/str}}</th></tr></thead><tbody>
{{#rows}}<tr><td>{{type}}<br>{{name}}</td><td><div class="l10-wrap">{{question}}</div>{{#choices}}<div>{{letter}}: {{text}}</div>{{/choices}}</td><td>{{answer}} / {{marks}}</td></tr>{{/rows}}</tbody></table></div>
<form method="post"><input type="hidden" name="id" value="{{id}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="token" value="{{token}}">
<button name="action" value="confirm" class="btn btn-primary">{{#str}}confirmimport,mod_lumen10prova{{/str}}</button>
<button name="action" value="cancel" class="btn btn-outline-secondary">{{#str}}cancelimport,mod_lumen10prova{{/str}}</button></form>{{/haspreview}}</div>
