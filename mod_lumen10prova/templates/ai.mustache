<div class="l10-card"><h3>{{#str}}aititle,mod_lumen10prova{{/str}}</h3>
<p>{{#str}}aiconfig,mod_lumen10prova{{/str}}</p><p>{{#str}}aiinstructions,mod_lumen10prova{{/str}}</p>
{{^enabled}}<p>{{#str}}aidisabled,mod_lumen10prova{{/str}}</p>{{/enabled}}
{{#enabled}}<form method="post"><input type="hidden" name="id" value="{{id}}"><input type="hidden" name="sesskey" value="{{sesskey}}">
<label for="l10-prompt">{{#str}}aiprompt,mod_lumen10prova{{/str}}</label><textarea id="l10-prompt" class="form-control" name="prompt" maxlength="12000" rows="8" required></textarea>
<label><input type="checkbox" name="consent" value="1" required> {{#str}}aiconsent,mod_lumen10prova{{/str}}</label>
<p><button class="btn btn-primary">{{#str}}aisubmit,mod_lumen10prova{{/str}}</button></p></form>{{/enabled}}
{{#answer}}<h4>{{#str}}aisuggestion,mod_lumen10prova{{/str}}</h4><pre class="l10-wrap">{{answer}}</pre>{{/answer}}</div>
